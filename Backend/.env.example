# Application
APP_ENV=dev
APP_NAME=Leowong CMS Backend
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Security
SECRET_KEY=change-me-in-production-please-use-32-bytes-random
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256

# CORS（CMS 管理端 + Leowongwebsite 公网前台）
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:4173","http://127.0.0.1:5173"]

# 数据库（默认本地 SQLite，生产可换 PostgreSQL）
# 例：postgresql+asyncpg://user:password@host:5432/leowong_cms
DATABASE_URL=sqlite+aiosqlite:///./var/leowong_cms.db

# 上传
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=20
PUBLIC_BASE_URL=http://localhost:8000

# 限流（slowapi）
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_UPLOAD=30/minute

# 默认管理员（首次启动自动创建）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456
DEFAULT_ADMIN_EMAIL=admin@leowong.example.com
